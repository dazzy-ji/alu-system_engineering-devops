#!/usr/bin/env bash
# Configures Nginx with a custom 404 error page returning 'Ceci n'est pas une page'

# Ensure Nginx is installed
apt-get update -y
apt-get install -y nginx

# Create the custom 404 error page content
echo "Ceci n'est pas une page" > /usr/share/nginx/html/custom_404.html

# Configure Nginx to use the custom error page and return 404 status code
sed -i "/server_name _;/a \    error_page 404 /custom_404.html;\n    location = /custom_404.html {\n        internal;\n    }" /etc/nginx/sites-enabled/default

# Restart Nginx
/etc/init.d/nginx restart
