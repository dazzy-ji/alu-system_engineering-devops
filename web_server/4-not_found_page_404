#!/usr/bin/env bash
# Configures Nginx with a custom 404 error page containing 'Ceci n'est pas une page'

apt-get update -y
apt-get install -y nginx

# Create the custom 404 page content
echo "Ceci n'est pas une page" > /usr/share/nginx/html/custom_404.html

# Configure Nginx error_page directive inside the default server block
sed -i 's|server_name _;|server_name _;\n\n    error_page 404 /custom_404.html;\n    location = /custom_404.html {\n        internal;\n    }|' /etc/nginx/sites-available/default

/etc/init.d/nginx restart
