#!/usr/bin/env bash
# Configures Nginx with a custom 404 error page

apt-get update -y
apt-get install nginx -y

# Create the custom 404 page content
echo "Ceci n'est pas une page" > /usr/share/nginx/html/custom_404.html

# Configure Nginx to use the custom 404 page
sudo sed -i "s|server {|server {\n\terror_page 404 /custom_404.html;\n\tlocation = /custom_404.html {\n\t\troot /usr/share/nginx/html;\n\t\tinternal;\n\t}|" /etc/nginx/sites-available/default

service nginx restart
