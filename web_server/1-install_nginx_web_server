#!/usr/bin/env bash
# Installs and configures Nginx to listen on port 80 and return 'Holberton School for the win!' at root

# Update package lists and install nginx non-interactively
apt-get update -y
apt-get install -y nginx

# Configure the default index page to return the required string
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html

# Restart Nginx using init.d (systemctl is restricted)
/etc/init.d/nginx restart
