#!/usr/bin/env bash
# Configures Nginx with a 301 redirection for /redirect_me

apt-get update -y
apt-get install nginx -y

# Insert the redirection block inside the default server configuration before the last closing brace
sudo sed -i "s|server {|server {\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}|" /etc/nginx/sites-available/default

service nginx restart
