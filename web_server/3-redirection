#!/usr/bin/env bash
# Configures Nginx with a 301 Moved Permanently redirect from /redirect_me to the specified YouTube URL

apt-get update -y
apt-get install -y nginx

# Safely add the redirection block right inside the default server block
sed -i 's|server_name _;|server_name _;\n\n    location /redirect_me {\n        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n    }|' /etc/nginx/sites-available/default

/etc/init.d/nginx restart
