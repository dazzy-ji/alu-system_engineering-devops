#!/usr/bin/env bash
# Configures Nginx with a 301 Moved Permanently redirect from /redirect_me to a YouTube video

# Ensure Nginx is installed
apt-get update -y
apt-get install -y nginx

# Insert the redirection rule inside the server block of the default Nginx configuration
sed -i "/server_name _;/a \    location /redirect_me {\n        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n    }" /etc/nginx/sites-enabled/default

# Restart Nginx
/etc/init.d/nginx restart
