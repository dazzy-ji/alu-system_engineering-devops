#!/usr/bin/env bash
# Displays DNS record information for a given domain and its subdomains or a specific subdomain

# shellcheck disable=SC2086
audit_dns() {
    local sub="$1"
    local dom="$2"
    local full_domain="${sub}.${dom}"
    
    # Query dig for the A record and extract the destination IP using awk
    local record_info
    record_info=$(dig +noall +answer ${full_domain} A | awk '{print $4, $5}')
    
    if [ -n "$record_info" ]; then
        local rec_type
        local rec_dest
        rec_type=$(echo "$record_info" | awk '{print $1}')
        rec_dest=$(echo "$record_info" | awk '{print $2}')
        echo "The subdomain ${sub} is a ${rec_type} record and points to ${rec_dest}"
    fi
}

DOMAIN="$1"
SUBDOMAIN="$2"

if [ -n "$SUBDOMAIN" ]; then
    audit_dns "$SUBDOMAIN" "$DOMAIN"
else
    for sub in www lb-01 web-01 web-02; do
        audit_dns "$sub" "$DOMAIN"
    done
fi
