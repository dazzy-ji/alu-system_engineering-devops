global
	log /dev/log	local0
	log /dev/log	local1 notice
	chroot /var/lib/haproxy
	user haproxy
	group haproxy
	daemon
	ca-base /etc/ssl/certs
	crt-base /etc/ssl/private

defaults
	log	global
	mode	http
	option	httplog
	option	dontlognull
	timeout connect 5000ms
	timeout client  50000ms
	timeout server  50000ms

frontend haproxy_frontend
	bind *:80
	bind *:443 ssl crt /etc/haproxy/certs/yourdomain.tech.pem
	
	# Redirect HTTP to HTTPS with a 301 Moved Permanently code
	redirect scheme https code 301 if !{ ssl_fc }

	default_backend haproxy_backend

backend haproxy_backend
	balance roundrobin
	server web-01 13.40.55.254:80 check
	server web-02 18.130.43.202:80 check
