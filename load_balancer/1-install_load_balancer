#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 to balance traffic between web-01 and web-02 using round-robin

export DEBIAN_FRONTEND=noninteractive

# Update and install HAProxy
apt-get update -y
apt-get install -y haproxy

# Enable HAProxy to be started by the init script
sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/haproxy

# Configure HAProxy settings for round-robin balancing to web-01 and web-02
cat << 'EOF' > /etc/haproxy/haproxy.cfg
global
	log /dev/log	local0
	log /dev/log	local1 notice
	chroot /var/lib/haproxy
	user haproxy
	group haproxy
	daemon

defaults
	log	global
	mode	http
	option	httplog
	option	dontlognull
	timeout connect 5000ms
	timeout client  50000ms
	timeout server  50000ms

frontend haproxy_frontend
	bind *:80
	default_backend haproxy_backend

backend haproxy_backend
	balance roundrobin
	server 7292-web-01 13.40.55.254:80 check
	server 7292-web-02 54.89.38.100:80 check
EOF

# Restart HAProxy to apply configuration changes
service haproxy restart
