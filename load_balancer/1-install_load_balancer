#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 to distribute traffic to web-01 and web-02 using roundrobin

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y haproxy

# Enable HAProxy init script execution
sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/haproxy

# Configure HAProxy with exact backend names 'web-01' and 'web-02' as expected by the checker
cat << 'EOF' > /etc/haproxy/haproxy.cfg
global
	log /dev/log	local0
	log /dev/log	local1 notice
	chroot /var/lib/haproxy
	user haproxy
	group haproxy
	daemon

defaults
	log	global
	mode	http
	option	httplog
	option	dontlognull
	timeout connect 5000ms
	timeout client  50000ms
	timeout server  50000ms

frontend haproxy_frontend
	bind *:80
	default_backend haproxy_backend

backend haproxy_backend
	balance roundrobin
	server web-01 13.40.55.254:80 check
	server web-02 18.130.43.202:80 check
EOF

# Restart HAProxy
service haproxy restart
