#!/usr/bin/env bash
# Configure Nginx to add a custom X-Served-By response header with the server hostname

# shellcheck disable=SC2154
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y nginx

# Ensure default index page exists
echo "Holberton School" > /var/www/html/index.html

# Remove any existing add_header line to prevent duplicates, then insert add_header right inside the server block
sed -i '/add_header X-Served-By/d' /etc/nginx/sites-available/default
sed -i '/server_name _;/a \    add_header X-Served-By $hostname;' /etc/nginx/sites-available/default

# Restart Nginx via init script
service nginx restart
