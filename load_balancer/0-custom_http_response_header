#!/usr/bin/env bash
# Configures Nginx to add a custom X-Served-By response header containing the server hostname

# shellcheck disable=SC2154
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y nginx

# Ensure default index page exists
echo "Holberton School" > /var/www/html/index.html

# Safely add the header directive with an escaped dollar sign so Nginx evaluates $hostname dynamically
if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
    sed -i '/server_name _;/a \    add_header X-Served-By \$hostname;' /etc/nginx/sites-available/default
fi

# Restart Nginx via init script
service nginx restart
